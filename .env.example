# Provider selection: auto, nebius, openrouter, or nvidia.
# auto prefers Nebius, then OpenRouter, then NVIDIA when multiple keys exist.
# Set this explicitly to avoid accidentally using a paid provider.
SCOUT_PROVIDER=auto

# Nebius Token Factory (primary/paid provider)
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1/

# OpenRouter (free Nemotron variants; useful for local testing)
# OPENROUTER_KEY and OPENROUTER_API_KEY are both accepted.
OPENROUTER_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1/

# Optional NVIDIA NIM fallback (used when no Nebius/OpenRouter key exists)
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

# Gemini 3.5 Flash-Lite extraction (runner/API default; key from Google AI Studio)
GEMINI_KEY=

# TinyFish Search + Fetch: default general search and page reader.
# Keep the account on free allowances; Scout locally caps each at 100 attempts/day.
TINYFISH_API_KEY=

# Tavily Search API: optional --search-provider tavily, not an automatic fallback.
# The free plan includes 1,000 basic search credits/month and requires no credit card.
TAVILY_API_KEY=

# Optional model overrides. Leave unset to use provider defaults.
# Nebius defaults: nvidia/nemotron-3.5-lightning,
#   nvidia/nemotron-3.5-super-vl-120b-a12b, nvidia/nemotron-3-ultra-550b-a55b
# OpenRouter defaults: nvidia/nemotron-3.5-lightning:free,
#   nvidia/nemotron-3.5-super-vl:free, nvidia/nemotron-3-ultra-550b-a55b:free
# SCOUT_MODEL_FAST=
# SCOUT_MODEL_STRONG=
# SCOUT_MODEL_ESCALATION=

SCOUT_USER_AGENT=NemotronScout/0.1
SCOUT_ALLOW_LOCALHOST=0
SCOUT_ENABLE_ULTRA=0
